# Copy to .env on the server and fill in. Never commit .env or paste these values into a chat.

# Supabase: Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The secret / service_role key. Server only. It bypasses row-level security.
SUPABASE_SERVICE_KEY=

# Your user id: Supabase > Authentication > Users > your row > UID
USER_ID=

# Google Cloud > Google Auth Platform > Clients > your web client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI providers (new keys, not the ones from the old n8n workflows)
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# preview  = build what would be sent to the AI, send nothing
# dry-run  = call the AI, write a report, create nothing
# live     = create and update items, poll every POLL_MINUTES
MODE=dry-run

# Used until an app reports your device's timezone
DEFAULT_TIMEZONE=Australia/Sydney
POLL_MINUTES=15
BACKFILL_DAYS=30
# How many recent emails a preview or dry-run looks at
DRY_RUN_LIMIT=60
# During the first 30-day read, skip things whose date has already passed
BACKFILL_SKIP_PAST=true

# For the Brightspace commands. Anyone with this URL can read your calendar.
# After `make connect-brightspace` it lives in the Vault and can be removed from here.
BRIGHTSPACE_FEED_URL=

# Push notifications: a contact address the push services can use if something misbehaves.
PUSH_CONTACT=mailto:you@example.com
